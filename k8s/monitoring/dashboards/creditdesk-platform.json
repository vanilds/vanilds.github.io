{
 "uid": "creditdesk-platform",
 "title": "CreditDesk \u2014 platform",
 "description": "The one EC2 node: memory (the scarce resource), pods, restarts, backups and the Ingress.",
 "tags": [
  "creditdesk"
 ],
 "timezone": "America/Sao_Paulo",
 "editable": false,
 "schemaVersion": 41,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Node (t4g.medium, 4 GB + 2 GB swap)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Memory available",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0
       },
       {
        "color": "orange",
        "value": 0.1
       },
       {
        "color": "green",
        "value": 0.2
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Swap used",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 536870912
       },
       {
        "color": "red",
        "value": 1258291200
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 3,
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Root disk free",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!=\"tmpfs\"}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0
       },
       {
        "color": "orange",
        "value": 0.15
       },
       {
        "color": "green",
        "value": 0.3
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 4,
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Last backup",
   "description": "Age of the last successful pg_dump to S3. Weekdays at 19:30; the node is off on weekends.",
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(kube_cronjob_status_last_successful_time{namespace=\"creditdesk\", cronjob=\"postgres-backup\"})",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 93600
       },
       {
        "color": "red",
        "value": 259200
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 5,
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Last restore test",
   "description": "A backup that was never restored is a hope, not a backup.",
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(kube_cronjob_status_last_successful_time{namespace=\"creditdesk\", cronjob=\"postgres-restore-test\"})",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 691200
       },
       {
        "color": "red",
        "value": 1296000
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 6,
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Monitoring on the node",
   "description": "Alloy + kube-state-metrics. In-cluster Prometheus + Grafana took the node down (incident 2026-11-05).",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(container_memory_working_set_bytes{namespace=\"monitoring\"})",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 268435456
       },
       {
        "color": "red",
        "value": 419430400
       }
      ]
     },
     "noValue": "\u2013"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 7,
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Node memory",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "used"
    },
    {
     "refId": "B",
     "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
     "legendFormat": "swap used"
    },
    {
     "refId": "C",
     "expr": "node_memory_MemTotal_bytes",
     "legendFormat": "total RAM"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 8,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Node CPU (2 vCPU)",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!~\"idle|iowait|steal\"}[$__rate_interval]))",
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 9,
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "Pods",
   "id": 10,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Memory by pod (working set)",
   "description": "Working set = what the kernel counts against the limit (the OOM killer looks at this).",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"creditdesk|monitoring|argocd\"})",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 11,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "table",
   "title": "Memory vs limit",
   "description": "Above ~0.9 the container is next in line for an OOM kill.",
   "targets": [
    {
     "refId": "A",
     "expr": "max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=~\"creditdesk|monitoring\"})\n        / on (namespace, pod, container) group_left\n        max by (namespace, pod, container) (kube_pod_container_resource_limits{resource=\"memory\", namespace=~\"creditdesk|monitoring\"})",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 12,
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Restarts (last hour)",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"creditdesk|monitoring\"}[1h])) > 0",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 13,
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "OOM kills",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace, pod) (increase(container_oom_events_total{namespace=~\"creditdesk|monitoring\"}[$__rate_interval])) > 0",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 14,
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "API replicas (HPA on CPU)",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"creditdesk\", horizontalpodautoscaler=\"api\"}",
     "legendFormat": "current"
    },
    {
     "refId": "B",
     "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"creditdesk\", horizontalpodautoscaler=\"api\"}",
     "legendFormat": "max"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 15,
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "CPU by pod",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"creditdesk|monitoring\"}[$__rate_interval]))",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 16,
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "Ingress (Traefik)",
   "id": 17,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requests by service",
   "description": "Everything that reaches the cluster: shell, micro frontends, API, Keycloak.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(traefik_service_requests_total[$__rate_interval]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 18,
   "gridPos": {
    "x": 0,
    "y": 41,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "5xx at the Ingress",
   "description": "502/503 here and not in the API = no pod was ready to take the request.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(traefik_service_requests_total{code=~\"5..\"}[$__rate_interval]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 19,
   "gridPos": {
    "x": 12,
    "y": 41,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  }
 ],
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "regex": "/-prom$|^Prometheus$/",
    "current": {},
    "hide": 0,
    "refresh": 1
   }
  ]
 }
}
