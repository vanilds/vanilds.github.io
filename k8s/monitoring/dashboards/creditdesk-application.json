{
 "uid": "creditdesk-app",
 "title": "CreditDesk \u2014 application",
 "description": "Golden signals of the API, the event pipeline (outbox \u2192 RabbitMQ \u2192 AI worker) and the JVM.",
 "tags": [
  "creditdesk"
 ],
 "timezone": "America/Sao_Paulo",
 "editable": false,
 "schemaVersion": 41,
