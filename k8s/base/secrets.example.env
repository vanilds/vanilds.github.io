# Keys of the Secret "creditdesk-secrets" that every overlay must provide. Example values only — never real ones.
# overlays/local: k8s/local/up.sh writes overlays/local/secrets.env with random values (git-ignored).
# overlays/aws (Phase 6): values come from SSM Parameter Store, never from git.
DB_USER=creditdesk
DB_PASSWORD=change-me
# Letters and digits only: KEDA reads this password to check the queue length and refuses special characters
RABBITMQ_USER=creditdesk
RABBITMQ_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# 32 random bytes each, base64 (openssl rand -base64 32): CPF/CNPJ encryption (AES-256-GCM) and search hash (HMAC)
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_HASH_KEY=
# Local S3 (SeaweedFS) only. On AWS the API uses the EC2 instance role: no S3 keys exist at all.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: API key of the language model. Empty = the worker writes the opinion from its rules template.
LLM_API_KEY=
