{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartStopOnlyCreditDesk",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "arn:aws:ec2:us-east-1:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/Project": "creditdesk" }
      }
    },
    {
      "Sid": "ReadInstanceState",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
